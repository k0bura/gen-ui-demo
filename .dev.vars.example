# Local secrets for `wrangler pages dev`. Copy to `.dev.vars` (gitignored)
# and paste your key. The Astro dev server runs the frontend without this
# file; only the Pages Function endpoint needs it.

ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model for one stage. See "Cost and models" in the
# README before changing these.
# MODEL_COMPONENTS=claude-opus-4-6
# MODEL_STRUCTURE=claude-sonnet-4-6
# MODEL_LAYOUT=claude-haiku-4-5
# MODEL_FOLLOW_UPS=claude-haiku-4-5

# Cloudflare Turnstile. Leave both unset for local development: the function
# only skips the check on localhost, and answers 503 anywhere else without a
# secret. In production the site key (public) lives in wrangler.toml [vars]
# as TURNSTILE_SITE_KEY, and TURNSTILE_SECRET_KEY is a Pages secret.
# To exercise the flow locally, use Cloudflare's always-pass test keys:
# TURNSTILE_SITE_KEY=1x00000000000000000000AA
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
