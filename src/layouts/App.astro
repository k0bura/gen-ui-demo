---
import "../styles/global.css";

// Shoelace's dark-theme CSS is safe at SSR; the JS autoloader uses
// MutationObserver and must load on the client only — registered via a
// <script> tag below.
import "@shoelace-style/shoelace/dist/themes/dark.css";

import { LAYOUT_SPEC, specToCss } from "../demo/layout-spec";

// Row-pattern tracks, gap sizes and type styles, generated from the same
// spec the prompts and the layout repair read.
const specCss = specToCss(LAYOUT_SPEC);

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Gen UI demo: a Claude tool-use pipeline that fetches live data and composes UI from a web-component library, with layout rules enforced in code. No code generation.",
} = Astro.props;
---

<!doctype html>
<html lang="en" class="sl-theme-dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0f172a" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <style is:inline set:html={specCss}></style>
  </head>
  <body>
    <slot />
    <script>
      // Point Shoelace's default icon library at the copy of dist/assets we
      // ship into /public/shoelace/. Must happen before the main bundle
      // registers components.
      import { setBasePath } from "@shoelace-style/shoelace/dist/utilities/base-path.js";
      setBasePath("/shoelace/");

      // All-in-one bundle: registers every sl-* tag up front. The
      // autoloader's lazy per-component import breaks under Vite because
      // its base-path resolution doesn't match Vite's served URLs.
      import "@shoelace-style/shoelace/dist/shoelace.js";
    </script>
  </body>
</html>
