---
import App from "../layouts/App.astro";
import GenUI from "../components/GenUI.svelte";
import pkg from "../../package.json";

const version = pkg.version as string;
---

<App title="Gen UI Demo">
  <header class="app-header">
    <div class="app-header-inner">
      <a href="/" class="brand">
        <span class="brand-mark" aria-hidden="true"></span>
        <span class="brand-name">Gen UI Demo</span>
        <span class="brand-version" aria-label={`Version ${version}`}>
          v{version}
        </span>
      </a>
      <nav class="app-nav" aria-label="External">
        <a
          href="https://github.com/k0bura/gen-ui-demo"
          target="_blank"
          rel="noopener noreferrer"
        >
          Source
          <span aria-hidden="true">&nearr;</span>
        </a>
        <a
          href="https://jeffmills.dev/projects/gen-ui-demo"
          target="_blank"
          rel="noopener noreferrer"
        >
          About
          <span aria-hidden="true">&nearr;</span>
        </a>
      </nav>
    </div>
  </header>

  <main class="app-main" id="main">
    <section class="hero">
      <h1 class="hero-title">Generative UI without generating code</h1>
      <p class="hero-lede">
        Ask a question. A chain of Claude tool-use calls fetches live data,
        picks components from a web-component library, and arranges them
        into a page. The layout rules live in one spec file that both the
        prompts and the code read: the prompt asks for the pattern, and the
        code guarantees it. The model never writes code, CSS or sizes.
      </p>
    </section>

    <section class="demo">
      <GenUI client:load />
    </section>

    <section class="explainer">
      <h2 class="explainer-title">How it works</h2>
      <ol class="explainer-list">
        <li>
          <span class="explainer-step">1</span>
          <div>
            <h3>Data, then components</h3>
            <p>
              The first model works in a loop. It calls data tools (weather, exchange rates, Wikipedia) and the server returns small, labelled, pre-rounded results. Then it calls one tool per component. Those calls are never executed: the call is the output. A failed data call comes back as data, with an instruction not to fill the gap from memory.
            </p>
          </div>
        </li>
        <li>
          <span class="explainer-step">2</span>
          <div>
            <h3>Structure and roles</h3>
            <p>
              A second model reads the components and decides order, grouping, and what each piece of text is: a card title, a headline figure, body text. It never picks a size. If its answer is missing, malformed, or changes a figure, the first stage's output stands.
            </p>
          </div>
        </li>
        <li>
          <span class="explainer-step">3</span>
          <div>
            <h3>Layout from a closed set</h3>
            <p>
              A third, cheaper model sees one summary line per component, not the markup, and arranges them using six row patterns from the layout spec. The patterns, min-widths and grouping rules in its prompt are generated from the same spec file the code enforces.
            </p>
          </div>
        </li>
        <li>
          <span class="explainer-step">4</span>
          <div>
            <h3>Code passes</h3>
            <p>
              Between and after the model calls, plain code cleans the markup, repairs the layout so it obeys the spec whatever the model returned, and sets type sizes from each role and the width of its slot. These passes are unit tested and run in mock mode too.
            </p>
          </div>
        </li>
        <li>
          <span class="explainer-step">5</span>
          <div>
            <h3>Deterministic render</h3>
            <p>
              The app walks the layout tree and instantiates each web component. Standards-based custom elements, so the same components would work in Vue, Angular or plain HTML.
            </p>
          </div>
        </li>
        <li>
          <span class="explainer-step">6</span>
          <div>
            <h3>Follow-ups and memory</h3>
            <p>
              A last small call suggests three next prompts. The server is stateless: the browser sends back each earlier prompt with a short note of what was shown, and every turn fetches fresh data.
            </p>
          </div>
        </li>
      </ol>
      <p class="explainer-note">
        Layout grid, spacing and type scale follow IBM Carbon (2x Grid at the
        <code>lg</code> breakpoint, productive type tokens), whose Figma kit is
        free on Figma Community. The components are Shoelace. Open
        <a href="?mock">mock mode</a> to see the code passes work without an
        API key: the canned answer is written with mistakes on purpose.
      </p>
    </section>
  </main>

  <footer class="app-footer">
    <div class="app-footer-inner">
      <span class="muted">
        Built by <a href="https://jeffmills.dev">Jeff Mills</a> &middot;
        Open source on
        <a
          href="https://github.com/k0bura/gen-ui-demo"
          target="_blank"
          rel="noopener noreferrer"
        >
          GitHub
        </a>
      </span>
    </div>
  </footer>

</App>

<style>
  /* Layout */
  .app-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-surface-2);
    backdrop-filter: saturate(180%) blur(8px);
  }

  .app-header-inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: var(--space-4) var(--space-6);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-fg);
    text-decoration: none;
    font-weight: 600;
  }

  .brand:hover {
    text-decoration: none;
    color: var(--color-fg);
  }

  .brand-mark {
    width: 1.25rem;
    height: 1.25rem;
    border-radius: var(--radius-sm);
    background: linear-gradient(135deg, var(--color-accent), #6366f1);
    box-shadow: 0 0 0 1px var(--color-surface-2);
  }

  .brand-name {
    font-size: 0.95rem;
    letter-spacing: -0.01em;
  }

  .brand-version {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--color-fg-muted);
    background: var(--color-surface);
    border: 1px solid var(--color-surface-2);
    padding: 0.1rem 0.4rem;
    border-radius: 999px;
    letter-spacing: 0;
    line-height: 1;
    /* Pull up slightly so the pill sits aligned with the cap height,
       not the baseline, of the brand name. */
    transform: translateY(-1px);
  }

  .brand:hover .brand-version {
    color: var(--color-fg);
    border-color: var(--color-surface-hover);
  }

  .app-nav {
    display: flex;
    gap: var(--space-5);
    font-size: 0.875rem;
  }

  .app-nav a {
    color: var(--color-fg-muted);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 0.2em;
  }

  .app-nav a:hover {
    color: var(--color-fg);
    text-decoration: none;
  }

  .app-main {
    max-width: 72rem;
    margin: 0 auto;
    padding: var(--space-12) var(--space-6) var(--space-12);
  }

  /* Hero */
  .hero {
    margin-bottom: var(--space-10);
    max-width: 48rem;
  }

  .hero-title {
    font-size: clamp(1.75rem, 2.5vw + 1rem, 2.5rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-4);
  }

  .hero-lede {
    font-size: 1.05rem;
    color: var(--color-fg-muted);
    margin: 0;
  }

  /* Demo container */
  .demo {
    background: var(--color-surface);
    border: 1px solid var(--color-surface-2);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    margin-bottom: var(--space-12);
    box-shadow: var(--shadow-md);
  }

  /* Explainer */
  .explainer-title {
    font-size: 1.5rem;
    margin-bottom: var(--space-6);
  }

  .explainer-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-6);
    grid-template-columns: 1fr;
  }

  @media (min-width: 768px) {
    .explainer-list {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .explainer-list > li {
    display: flex;
    gap: var(--space-4);
    align-items: flex-start;
    background: var(--color-surface);
    border: 1px solid var(--color-surface-2);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
  }

  .explainer-step {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.75rem;
    height: 1.75rem;
    flex-shrink: 0;
    border-radius: var(--radius-md);
    background: var(--color-accent-soft);
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 0.875rem;
  }

  .explainer-list h3 {
    font-size: 1rem;
    margin-bottom: var(--space-2);
  }

  .explainer-list p {
    color: var(--color-fg-muted);
    font-size: 0.9rem;
    margin: 0;
  }

  .explainer-note {
    margin: var(--space-6) 0 0;
    color: var(--color-fg-muted);
    font-size: 0.875rem;
    max-width: 48rem;
  }

  /* Footer */
  .app-footer {
    border-top: 1px solid var(--color-surface-2);
    margin-top: var(--space-12);
  }

  .app-footer-inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: var(--space-6);
    font-size: 0.875rem;
    color: var(--color-fg-muted);
  }

  .muted {
    color: var(--color-fg-muted);
  }
</style>
